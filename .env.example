# PTK Digital Platform — environment configuration
# Copy to .env (or set these in the Render dashboard) and adjust as needed.

NODE_ENV=production
PORT=3000
TRUST_PROXY=1
PUBLIC_BASE_URL=https://ptk-puthiya-thalaimurai-kazhagam.onrender.com

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# First-run administrator account. If INITIAL_ADMIN_PASSWORD is left empty the
# built-in default "PTKadmin@2026" is used (change it after first login).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Persistent storage. On Render these point at the mounted disk (/var/data).
# Locally they fall back to ./data automatically when /var/data is unavailable.
PERSISTENT_STORAGE_ROOT=/var/data
DB_PATH=/var/data/ptk.db
BACKUP_DIR=/var/data/backups
UPLOAD_DIR=/var/data/uploads
MEMBER_CSV_PATH=/var/data/ptk-members.csv
