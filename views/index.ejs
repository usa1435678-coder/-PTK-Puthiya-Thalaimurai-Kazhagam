<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= settings.party_name_english || 'PTK — Puthiya Thalaimurai Kazhagam' %> | Home</title>
    <meta name="description" content="PTK party website and membership platform" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="stylesheet" href="/styles.css?v=20261015-scrollfix" />
    <script src="/language.js" defer></script>
  </head>
  <body>
    <header class="site-header">
      <div class="container topbar">
        <div class="brand">
          <% if (settings.logo_url) { %>
            <img class="brand-logo" src="<%= settings.logo_url %>" alt="PTK logo" />
          <% } else { %>
            <div class="brand-mark">PTK</div>
          <% } %>
          <div>
            <div><%= settings.party_name_tamil || 'PTK — புதிய தலைமுறை கழகம்' %></div>
            <small><%= settings.party_name_english || 'PTK — Puthiya Thalaimurai Kazhagam' %></small>
          </div>
          <% if (settings.flag_url) { %>
            <img class="brand-flag" src="<%= settings.flag_url %>" alt="PTK flag" width="38" height="26" />
          <% } %>
        </div>
        <nav class="nav">
          <a href="#about">About</a>
          <a href="#mission">Vision</a>
          <a href="#announcements">Announcements</a>
          <a href="#events">Events</a>
          <a href="/membership">Membership</a>
          <a href="/application-status">Application status</a>
          <a href="/admin/login">Admin</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero"<% if (settings.hero_background_url) { %> style="background-image: linear-gradient(rgba(10, 12, 18, 0.55), rgba(10, 12, 18, 0.45)), url('<%= settings.hero_background_url %>');"<% } %>>
        <div class="container hero-grid">
          <div>
            <div class="eyebrow" style="color: #fff;"><%= settings.hero_welcome_text || 'Welcome to PTK' %></div>
            <h1><%= settings.party_name_tamil || 'PTK — புதிய தலைமுறை கழகம்' %></h1>
            <p><%= settings.tagline || 'Together for a stronger tomorrow' %></p>
            <div class="cta-row">
              <a class="btn btn-primary" href="/membership"><%= settings.hero_membership_cta || 'Apply for Membership' %></a>
              <a class="btn btn-secondary" href="#announcements"><%= settings.hero_updates_cta || 'Latest Updates' %></a>
            </div>
            <div class="stat-strip">
              <div class="stat-box">
                <strong><%= heroStats.members || 0 %></strong>
                <span><%= settings.hero_members_label || 'Members' %></span>
              </div>
              <div class="stat-box">
                <strong><%= heroStats.districts || 0 %></strong>
                <span><%= settings.hero_districts_label || 'Districts' %></span>
              </div>
              <div class="stat-box">
                <strong><%= heroStats.volunteers || 0 %></strong>
                <span><%= settings.hero_volunteers_label || 'Volunteers' %></span>
              </div>
            </div>
          </div>

          <div class="card-panel">
            <% if (settings.leader_photo_url) { %>
              <img class="leader-photo" src="<%= settings.leader_photo_url %>" alt="<%= settings.leader_name || 'PTK leader' %>" />
            <% } %>
            <% if (!settings.leader_photo_url && settings.logo_url) { %>
              <img class="brand-logo" src="<%= settings.logo_url %>" alt="PTK logo" />
            <% } else if (!settings.leader_photo_url) { %>
              <div class="brand-mark" style="width:64px;height:64px;font-size:1.4rem;margin-bottom:16px;">PTK</div>
            <% } %>
            <h3><%= settings.leader_name || 'PTK Leadership' %></h3>
            <p><%= settings.leader_title || 'Party President' %></p>
            <% if (settings.flag_url) { %><img class="brand-flag" src="<%= settings.flag_url %>" alt="PTK flag" /><% } %>
            <p><strong>Email:</strong> <%= settings.contact_email || 'hello@ptkparty.org' %></p>
            <p><strong>Phone:</strong> <%= settings.contact_phone || '+91 98765 43210' %></p>
            <p><strong>Address:</strong> <%= settings.contact_address || 'PTK Headquarters, Tamil Nadu' %></p>
          </div>
        </div>
      </section>

      <section id="about" class="section">
        <div class="container">
          <div class="section-header">
            <div class="eyebrow"><%= settings.about_eyebrow || 'About PTK' %></div>
            <h2><%= settings.about_heading || 'Building a strong, inclusive political future' %></h2>
          </div>
          <div class="grid-3">
            <div class="card">
              <div class="value-icon">🏛️</div>
              <h3><%= settings.about_legacy_heading || 'Our Legacy' %></h3>
              <p><%= settings.about_text || 'PTK is a people-first political movement founded on integrity, service, and progress for every community.' %></p>
            </div>
            <div class="card">
              <div class="value-icon">🎯</div>
              <h3>Mission</h3>
              <p><%= settings.mission_text || 'To build a just, people-led, transparent and inclusive political future for Tamil communities.' %></p>
            </div>
            <div class="card">
              <div class="value-icon">✨</div>
              <h3>Vision</h3>
              <p><%= settings.vision_text || 'To create a vibrant, responsive, and democratic society driven by dignity, opportunity and unity.' %></p>
            </div>
          </div>
        </div>
      </section>

      <section id="mission" class="section" style="background:#eef4ef;">
        <div class="container">
          <div class="section-header">
            <div class="eyebrow"><%= settings.principles_eyebrow || 'Core Principles' %></div>
            <h2><%= settings.principles_heading || 'Values that guide our work' %></h2>
          </div>
          <div class="list-grid">
            <div class="article-card">
              <h3><%= settings.principle_people_title || 'People First' %></h3>
              <p><%= settings.principle_people_text || 'We serve communities through direct engagement, ethical governance and long-term development.' %></p>
            </div>
            <div class="article-card">
              <h3><%= settings.principle_integrity_title || 'Integrity' %></h3>
              <p><%= settings.principle_integrity_text || 'Our politics are grounded in accountability, transparency and honest public leadership.' %></p>
            </div>
            <div class="article-card">
              <h3><%= settings.principle_progress_title || 'Progress' %></h3>
              <p><%= settings.principle_progress_text || 'We work to improve livelihoods, infrastructure, education, healthcare and opportunity for all.' %></p>
            </div>
            <div class="article-card">
              <h3><%= settings.principle_unity_title || 'Unity' %></h3>
              <p><%= settings.principle_unity_text || 'We bring together workers, youth, women, farmers and professionals around common goals.' %></p>
            </div>
          </div>
        </div>
      </section>

      <section id="announcements" class="section">
        <div class="container">
          <div class="section-header">
            <div class="eyebrow"><%= settings.announcements_eyebrow || 'Announcements' %></div>
            <h2><%= settings.announcements_heading || 'Latest updates from PTK' %></h2>
          </div>
          <div class="list-grid">
            <% announcements.forEach((item) => { %>
              <article class="article-card">
                <h3><%= item.title %></h3>
                <p><%= item.content %></p>
                <div class="meta"><%= formatDate(item.created_at) %></div>
              </article>
            <% }) %>
          </div>
        </div>
      </section>

      <section id="events" class="section" style="background:#f6f9f5;">
        <div class="container">
          <div class="section-header">
            <div class="eyebrow"><%= settings.events_eyebrow || 'Events' %></div>
            <h2><%= settings.events_heading || 'Upcoming public engagements' %></h2>
          </div>
          <div class="list-grid">
            <% events.forEach((event) => { %>
              <article class="article-card">
                <h3><%= event.title %></h3>
                <p><strong>Location:</strong> <%= event.location %></p>
                <p><strong>Date:</strong> <%= formatDate(event.event_date) %></p>
                <p><%= event.description %></p>
              </article>
            <% }) %>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-header">
            <div class="eyebrow"><%= settings.involvement_eyebrow || 'Get Involved' %></div>
            <h2><%= settings.involvement_heading || 'Join the movement' %></h2>
          </div>
          <div class="list-grid">
            <div class="form-shell">
              <h3><%= settings.join_membership_title || 'Membership application' %></h3>
              <p><%= settings.join_membership_text || 'Become a member and help build a stronger political future.' %></p>
              <a class="btn btn-primary" href="/membership">Apply now</a>
            </div>
            <div class="form-shell">
              <h3><%= settings.join_volunteer_title || 'Volunteer with PTK' %></h3>
              <p><%= settings.join_volunteer_text || 'Support campaigns, social work, and community outreach.' %></p>
              <button class="btn btn-secondary" onclick="document.getElementById('volunteerForm').scrollIntoView({behavior:'smooth'})">Volunteer</button>
            </div>
            <div class="form-shell">
              <h3><%= settings.join_grievance_title || 'Raise a grievance' %></h3>
              <p><%= settings.join_grievance_text || 'Share your concern for appropriate review by the party team.' %></p>
              <button class="btn btn-secondary" onclick="document.getElementById('grievanceForm').scrollIntoView({behavior:'smooth'})">Report</button>
            </div>
          </div>
        </div>
      </section>

      <section class="section" style="background:#fff;">
        <div class="container">
          <div class="section-header">
            <div class="eyebrow"><%= settings.public_forms_eyebrow || 'Public Forms' %></div>
            <h2><%= settings.public_forms_heading || 'Submit your details securely' %></h2>
          </div>
          <div class="list-grid">
            <div class="form-shell" id="volunteerForm">
              <h3><%= settings.volunteer_form_heading || 'Volunteer registration' %></h3>
              <form id="volunteerFormInner">
                <div class="form-row">
                  <div>
                    <label>Full name</label>
                    <input name="full_name" required />
                  </div>
                  <div>
                    <label>Phone</label>
                    <input name="phone" required />
                  </div>
                  <div>
                    <label>Email</label>
                    <input name="email" type="email" />
                  </div>
                  <div>
                    <label>District</label>
                    <input name="district" required />
                  </div>
                  <div>
                    <label>Area of interest</label>
                    <input name="interest" required />
                  </div>
                  <div>
                    <label>Availability</label>
                    <input name="availability" />
                  </div>
                </div>
                <div style="margin-top: 12px;">
                  <label>Message</label>
                  <textarea name="message"></textarea>
                </div>
                <div style="margin-top: 16px;">
                  <button class="btn btn-primary" type="submit">Submit</button>
                </div>
              </form>
            </div>

            <div class="form-shell" id="grievanceForm">
              <h3><%= settings.grievance_form_heading || 'Public grievance' %></h3>
              <form id="grievanceFormInner">
                <div class="form-row">
                  <div>
                    <label>Full name</label>
                    <input name="full_name" required />
                  </div>
                  <div>
                    <label>Phone</label>
                    <input name="phone" required />
                  </div>
                </div>
                <div style="margin-top: 12px;">
                  <label>District</label>
                  <input name="district" />
                </div>
                <div style="margin-top: 12px;">
                  <label>Subject</label>
                  <input name="subject" required />
                </div>
                <div style="margin-top: 12px;">
                  <label>Message</label>
                  <textarea name="message" required></textarea>
                </div>
                <div style="margin-top: 16px;">
                  <button class="btn btn-primary" type="submit">Send grievance</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="form-shell">
            <h3><%= settings.contact_form_heading || 'Contact PTK' %></h3>
            <form id="contactForm">
              <div class="form-row">
                <div>
                  <label>Full name</label>
                  <input name="full_name" required />
                </div>
                <div>
                  <label>Email</label>
                  <input name="email" type="email" />
                </div>
                <div>
                  <label>Phone</label>
                  <input name="phone" />
                </div>
                <div>
                  <label>Subject</label>
                  <input name="subject" required />
                </div>
              </div>
              <div style="margin-top: 12px;">
                <label>Message</label>
                <textarea name="message" required></textarea>
              </div>
              <div style="margin-top: 16px;">
                <button class="btn btn-primary" type="submit">Send message</button>
              </div>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <h4>PTK</h4>
          <p><%= settings.party_name_english || 'PTK — Puthiya Thalaimurai Kazhagam' %></p>
        </div>
        <div>
          <h4><%= settings.footer_quick_links_heading || 'Quick Links' %></h4>
          <ul>
            <li><a href="#about">About</a></li>
            <li><a href="#announcements">Announcements</a></li>
            <li><a href="/membership">Membership</a></li>
            <li><a href="/application-status">Application status</a></li>
          </ul>
        </div>
        <div>
          <h4><%= settings.footer_resources_heading || 'Resources' %></h4>
          <ul>
            <li><a href="/admin/login">Admin</a></li>
            <li><a href="/application-status">Application status lookup</a></li>
            <li><a href="#events">Events</a></li>
          </ul>
        </div>
        <div>
          <h4><%= settings.footer_contact_heading || 'Contact' %></h4>
          <ul>
            <li><%= settings.contact_email || 'hello@ptkparty.org' %></li>
            <li><%= settings.contact_phone || '+91 98765 43210' %></li>
            <li><%= settings.contact_address || 'PTK Headquarters, Tamil Nadu' %></li>
            <li><a href="/privacy">Privacy policy</a></li>
            <li><a href="/terms">Terms and conditions</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script src="/app.js"></script>
  </body>
</html>
