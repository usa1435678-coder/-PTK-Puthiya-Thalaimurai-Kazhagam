<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Announcements | <%= settings.party_name_english || 'PTK' %></title>
    <link rel="stylesheet" href="/styles.css?v=20261015-scrollfix" />
    <script src="/language.js" defer></script>
  </head>
  <body>
    <header class="site-header">
      <div class="container topbar">
        <div class="brand">
          <div class="brand-mark">PTK</div>
          <div>
            <div><%= settings.party_name_tamil %></div>
            <small><%= settings.party_name_english %></small>
          </div>
        </div>
        <nav class="nav">
          <a href="/admin/dashboard">Dashboard</a>
          <a href="/admin/logout">Logout</a>
        </nav>
      </div>
    </header>

    <main class="admin-shell">
      <div class="container" style="max-width: 980px;">
        <div class="section-header">
          <div class="eyebrow">Announcements</div>
          <h2>Create and publish updates</h2>
        </div>
        <% if (success) { %><div class="notice success"><%= success %></div><% } %>
        <div class="form-shell">
          <form method="POST" action="/admin/announcements">
            <div>
              <label>Title</label>
              <input name="title" required />
            </div>
            <div style="margin-top: 18px;">
              <label>Content</label>
              <textarea name="content" required></textarea>
            </div>
            <div class="checkbox-row" style="margin-top: 18px;">
              <input type="checkbox" name="published" value="1" />
              <label>Publish immediately</label>
            </div>
            <div style="margin-top: 18px;">
              <button class="btn btn-primary" type="submit">Save announcement</button>
            </div>
          </form>
        </div>

        <div class="dashboard-panel" style="margin-top: 24px;">
          <h3>Existing announcements</h3>
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Published</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% announcements.forEach((item) => { %>
                <tr>
                  <td>
                    <strong><%= item.title %></strong>
                    <details style="margin-top: 8px;">
                      <summary>Edit announcement</summary>
                      <form method="POST" action="/admin/announcements/<%= item.id %>/edit" style="margin-top: 12px;">
                        <label>Title<input name="title" value="<%= item.title %>" required /></label>
                        <label>Content<textarea name="content" required><%= item.content %></textarea></label>
                        <label class="checkbox-row"><input type="checkbox" name="published" value="1" <%= item.published ? 'checked' : '' %> /> Published</label>
                        <button class="btn btn-primary" type="submit">Save changes</button>
                      </form>
                    </details>
                  </td>
                  <td><%= item.published ? 'Yes' : 'No' %></td>
                  <td><%= formatDate(item.created_at) %></td>
                  <td>
                    <form method="POST" action="/admin/announcements/<%= item.id %>/delete" onsubmit="return confirm('Permanently delete this announcement?')">
                      <button class="btn btn-secondary" type="submit">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </body>
</html>
