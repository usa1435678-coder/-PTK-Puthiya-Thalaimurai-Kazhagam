<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login | PTK</title>
    <link rel="stylesheet" href="/styles.css?v=20261015-scrollfix" />
    <script src="/language.js" defer></script>
  </head>
  <body>
    <header class="site-header">
      <div class="container topbar">
        <div class="brand">
          <div class="brand-mark">PTK</div>
          <div>
            <div><%= settings.party_name_tamil %></div>
            <small><%= settings.party_name_english %></small>
          </div>
        </div>
        <nav class="nav">
          <a href="/">Public site</a>
        </nav>
      </div>
    </header>

    <main class="admin-shell">
      <div class="container" style="max-width: 560px;">
        <div class="form-shell">
          <h2>Administrator access</h2>
          <% if (error) { %>
            <div class="notice error"><%= error %></div>
          <% } %>
          <form method="POST" action="/admin/login">
            <div style="margin-bottom: 14px;">
              <label>Username</label>
              <input name="username" value="<%= username || '' %>" autocomplete="username" autocapitalize="none" spellcheck="false" required />
            </div>
            <div style="margin-bottom: 14px;">
              <label>Password</label>
              <input name="password" type="password" autocomplete="current-password" required />
            </div>
            <button class="btn btn-primary" type="submit">Login</button>
          </form>
        </div>
      </div>
    </main>
  </body>
</html>
